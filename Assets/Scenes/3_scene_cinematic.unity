--- !u!114 &1141195864
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1141195863}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 44c76409c8bc2b1ab8c3a6dc5cb86e72, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AshesOfRyu.CinematicSequence
  slides:
  - image: {fileID: 4139570518467378118, guid: dcf4bb8aafb46e38788e9783abde3bbf, type: 3}
    text: "Hace siglos, humanos y dragones libraron una guerra que lo consumi\xF3
      todo."
    duration: 8
  - image: {fileID: -249334301696837858, guid: e30d63ea4d5666cb38b1483d2f40d38c, type: 3}
    text: "Uno a uno, los dragones cayeron... hasta que solo qued\xF3 uno. Ryu, el
      \xFAltimo drag\xF3n verdadero."
    duration: 8
  - image: {fileID: 4149799358396556434, guid: 8c86befea64bf525289285495d676c2c, type: 3}
    text: "Para salvar a su especie, Ryu invoc\xF3 un poder prohibido: el de la resurrecci\xF3n."
    duration: 10
  - image: {fileID: 5375170803134068594, guid: e6f91e53b87c2e949b3211f4dc315012, type: 3}
    text: "El ritual funcion\xF3... pero los dragones regresaron con forma humana.
      Ya no eran lo que hab\xEDan sido."
    duration: 9
  - image: {fileID: -5144474021714010942, guid: 9047749850bf4d36a985f5a8c2eb087e, type: 3}
    text: "Ryu pag\xF3 el precio. Perdi\xF3 su poder, su cuerpo se redujo... y la
      muerte le fue negada. Maldito a vivir para siempre."
    duration: 10
  - image: {fileID: -2243825346249027255, guid: 7ad092bf2b928432c9f91d143c8d48f1, type: 3}
    text: "Pasaron los siglos. El mundo olvid\xF3... pero Ryu no."
    duration: 7
  - image: {fileID: -8595714342209496638, guid: a7b0a1ae94a26dcf0b1f99a927ab65c1, type: 3}
    text: "Hasta que un hada, que nunca dej\xF3 de buscar, despert\xF3 una chispa
      de su antiguo fuego."
    duration: 10
  - image: {fileID: 5108287475322439260, guid: 3924ee94c11d0cb3eb0cf8cd431b38ff, type: 3}
    text: "El camino lleva al castillo de Vareth... y a la \xFAnica esperanza de
      romper la maldici\xF3n."
    duration: 8
  slideImages:
  - {fileID: 1908657247}
  - {fileID: 1603928155}
  - {fileID: 1152474860}
  - {fileID: 511236522}
  - {fileID: 3524691}
  - {fileID: 197271123}
  - {fileID: 128694026}
  - {fileID: 730249921}
  narrationText: {fileID: 503471332}
  fadeOverlay: {fileID: 988266604}
